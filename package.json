{
  "name": "med-tracker-stack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "web:dev": "npm --prefix web run dev",
    "api:dev": "npm --prefix api run dev",
    "api:create-user": "npm --prefix api run create-user",
    "build": "npm --prefix web run build",
    "lint": "npm --prefix web run lint",
    "audit": "npm --prefix web audit && npm --prefix api audit",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  }
}
